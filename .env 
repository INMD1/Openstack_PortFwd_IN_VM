# .env.example - 환경 변수 설정 예시
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# ============================================================================
# 데이터베이스 설정 (SQLite 사용)
# ============================================================================
# SQLite (기본값 - 별도 설치 불필요)
DATABASE_URL=sqlite:///./portfwd_rules.db

# PostgreSQL을 사용하려면 위 줄을 주석처리하고 아래를 활성화
# DATABASE_URL=postgresql://user:password@localhost:5432/skyline_portfwd

# ============================================================================
# API 서버 설정
# ============================================================================
API_HOST=0.0.0.0
API_PORT=1420
LOG_LEVEL=info

# ============================================================================
# 환경 설정
# ============================================================================
# development: 시뮬레이션 모드 (iptables 실제 적용 안함)
# production: 실제 iptables 규칙 적용
ENV=development

# ============================================================================
# 실행 모드 설정
# ============================================================================
# local: Proxy VM 내부에서 직접 실행 (iptables 직접 호출)
# remote: 별도 서버에서 실행 (SSH로 Proxy VM에 iptables 전달)
PROXY_MODE=local

# ============================================================================
# Proxy VM SSH 연결 설정 (PROXY_MODE=remote 일 때만 필요)
# ============================================================================
# PROXY_VM_IP=10.0.0.10
# PROXY_VM_SSH_PORT=22
# PROXY_VM_SSH_USER=root
# PROXY_VM_SSH_KEY_PATH=/path/to/private_key

# ============================================================================
# Floating IP 설정 (역할별 분리)
# ============================================================================
# ⚠️ 중요: Proxy VM에서 iptables가 인식하는 IP를 입력하세요!
# - 외부 Floating IP가 아닌, 1:1 NAT으로 매핑된 Proxy VM의 내부 IP 입력
# - 예: 외부 203.0.113.11 → 내부 10.0.0.11 이면, 10.0.0.11 입력
# - Proxy VM에서 'ip addr' 명령으로 확인 가능
#
# 1번 IP: SSH 전용 - 랜덤 포트 할당
# (외부 Floating IP에 1:1 NAT된 Proxy VM 내부 IP)
SSH_FLOATING_IP=192.168.10.3

# 2번/3번 IP: 일반 포트포워딩용 - 두 IP 비교해서 여유있는 쪽 선택
# (각각 다른 외부 Floating IP에 1:1 NAT된 내부 IP)
PORTFWD_FLOATING_IP_1=192.168.10.179
PORTFWD_FLOATING_IP_2=192.168.10.16

# ============================================================================
# 포트 범위 설정
# ============================================================================
# SSH 전용 포트 범위 (1번 IP에서 사용)
SSH_PORT_MIN=1
SSH_PORT_MAX=1000

# 일반 포트포워딩 범위 (2번/3번 IP에서 사용)
PORTFWD_PORT_MIN=1
PORTFWD_PORT_MAX=1000

# 포트포워딩 제외 포트 (쉼표로 구분)
PORTFWD_EXCLUDED_PORTS=220,80,443,1420
# ============================================================================
# 용량 제한
# ============================================================================
# IP당 최대 규칙 수
MAX_RULES_PER_IP=600
